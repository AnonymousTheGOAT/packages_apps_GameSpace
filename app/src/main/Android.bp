package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "GameSpace",
    defaults: [
        "SettingsLibDefaults",
    ],
    platform_apis: true,
    privileged: true,
    privapp_allowlist: "privapp_whitelist_io.chaldeaprjkt.gamespace.xml",
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
    certificate: "platform",

    srcs: [
        "java/**/*.java",
        "java/**/*.kt",
        "java/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["java"],
    },
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "com.google.android.material_material",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "gson-prebuilt-jar-2.9.1",
        "hilt_android",
        "SettingsLibSettingsTheme",
        "LineagePreferenceLib",
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation-core",
        "androidx.compose.animation_animation-graphics",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material3_material3-window-size-class",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "kotlinx-coroutines-core",
        "androidx.lifecycle_lifecycle-runtime-compose",
    ],
    kotlincflags: [
        "-Xjvm-default=all",
        "-opt-in=kotlin.Experimental",
        "-opt-in=kotlin.ExperimentalStdlibApi",
        "-Xopt-in=kotlin.RequiresOptIn",
        "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true",
    ],
    plugins: [
        "dagger2-compiler",
        "androidx.room_room-compiler-plugin",
    ],

    optimize: {
        enabled: true,
        shrink: true,
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "ANGLE",
        "default-permissions_io.chaldeaprjkt.gamespace.xml",
    ],
}

prebuilt_etc {
    name: "default-permissions_io.chaldeaprjkt.gamespace.xml",
    src: "default-permissions_io.chaldeaprjkt.gamespace.xml",
    system_ext_specific: true,
    filename_from_src: true,
    relative_install_path: "default-permissions",
}
