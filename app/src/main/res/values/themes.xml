<resources>

    <style name="GameSpaceTheme" parent="Theme.SubSettingsBase.Expressive" />

    <style name="GameSpaceTheme.GameBar" parent="Theme.SubSettingsBase.Expressive">
        <item name="android:buttonStyle">@style/GameSpaceTheme.FlatButton</item>
        <item name="android:imageButtonStyle">@style/GameSpaceTheme.FlatButton</item>
    </style>

    <style name="GameSpaceTheme.FlatButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/ripple_circle</item>
        <item name="android:tint">@color/onBarBackground</item>
    </style>

    <style name="GameSpaceTheme.Panel" parent="GameSpaceTheme">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <style name="GameSpaceTheme.Panel.Tile">
        <item name="android:textColor">@color/onSurface</item>
    </style>

</resources>
